# Base URL of the Boveda backend (baked at build time; browser-visible, so no secrets here).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8012

# Optional. URL of the external Google Form for feedback. When set, the "Retroalimentacion"
# button of the Percepcion panel opens it in a new tab; when empty the button is hidden
# (Boveda has no internal Formularios module).
NEXT_PUBLIC_PERCEPCION_FEEDBACK_URL=
