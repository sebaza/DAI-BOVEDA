# Copy to backend/.env (gitignored) and fill in. Every variable is optional in dev.

# ---- App -------------------------------------------------------------------
# "dev" enables /auth/dev-login and tolerates the default session secret.
# ANYTHING ELSE is treated as production: dev-login returns 404 and the app REFUSES TO
# START unless APP_SESSION_SECRET is set to a strong, non-default value.
APP_ENV=dev
# Signs the session tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SESSION_SECRET=
# Session lifetime in seconds (default 8 h).
APP_SESSION_TTL_SECONDS=28800
# Origins allowed by CORS (comma separated). Default: localhost:3001 / 3000.
BACKEND_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---- Access control: ALLOWLIST ONLY (fail closed) ----------------------------
# Comma separated, case-insensitive. Empty = nobody gets in (except dev-login in dev).
# Can READ the Percepcion data:
BOVEDA_ALLOWED_EMAILS=
# DAI team: can read AND write (events, curation, forcing the paid weekly summary):
BOVEDA_TEAM_EMAILS=

# ---- Google sign-in ----------------------------------------------------------
# OAuth client id of the Google Identity Services button (public value, but the backend
# also uses it as the expected audience when verifying the ID token).
GOOGLE_CLIENT_ID=

# ---- Database ----------------------------------------------------------------
# Percepcion database. If empty it falls back to OPERATIONAL_DATABASE_URL, which defaults
# to a local SQLite file backend/percepcion.db (created empty on first start).
# Local dev with real data: a COPY of the worker's percepcion_real.db, e.g.
#   PERCEPCION_DATABASE_URL=sqlite:///C:/path/to/DAI-BOVEDA/backend/percepcion_real.db
# Cloud: the Postgres DSN the worker writes to, e.g. postgresql+psycopg2://user:pass@host:5432/db
PERCEPCION_DATABASE_URL=
OPERATIONAL_DATABASE_URL=

# ---- Scheduled tasks ---------------------------------------------------------
# Shared secret for POST /tasks/run/percepcion-resumen (header X-Tasks-Token).
# Empty = the trigger is disabled (403).
TASKS_TRIGGER_TOKEN=

# ---- LLM (weekly summary) ------------------------------------------------------
# Without a key the summary degrades by itself (no text is generated, nothing breaks).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model of the weekly summary. Empty = resumen_llm.MODELO_ANTHROPIC (claude-haiku-4-5).
PERCEPCION_RESUMEN_MODELO=
# Optional JSON overriding the price table, USD per million tokens.
LLM_PRECIOS_JSON=

# ---- Percepcion methodology knobs (change the index level: see services/percepcion) --
PERCEPCION_UNIDAD_DETECCION_SEMANAS=2
PERCEPCION_CREDITO_NO_ATRIBUIBLE=0.5
PERCEPCION_NEU_FEDERACION_ADVERSO=1
